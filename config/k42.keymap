#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    behaviors {
        comsemi: comma_semicolon {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp COMMA>, <&kp SEMI>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        dotcol: dot_colon {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp DOT>, <&kp COLON>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        marks: question_exclamation {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp QMARK>, <&kp EXCL>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
    };
        keymap {
                compatible = "zmk,keymap";

                default_layer {
                        display-name = "NORM";
//-----------------------------------------------------------------------------------
// |   Q   |   W   |   E   |   R   |   T   |   Y   |   U   |   I   |   O   |  ' "  |
// |   A   |   S   |   D   |   F   |   G   |   H   |   J   |   K   |   L   |   P   |
// |   Z   |   X   |   C   |   V   |   B   |   N   |   M   |  , ;  |  . :  |  ? !  |
//                 |  TAB  | SHIFT |  NAV  |  NUM  | SPACE |  DEL  |

                        bindings = <
   &kp Q &kp W &kp E &kp R &kp T   &kp Y &kp U &kp I &kp O   &kp SQT
   &kp A &kp S &kp D &kp F  &kp G   &kp H &kp J   &kp K &kp L &kp P
   &kp Z &kp X &kp C   &kp V          &kp B   &kp N &kp M     &comsemi &dotcol &marks
               &kp TAB &kp LSHIFT &mo 2 &mo 1 &kp SPACE &kp BSPC
                        >;
                };
                lower_layer {
                        display-name = "NUM";
//-----------------------------------------------------------------------------------
// |   [   |   {   |   (   |  - _  |  = +  |   *   |   /   |   )   |   }   |   ]   |
// |   1   |   2   |   3   |   4   |   5   |   6   |   7   |   8   |   9   |   0   |
// |  ` ~  |   @   |   #   |   $   |   %   |   ^   |   &   |   <   |   >   |  \ |  |
//                 |  TAB  | SHIFT |  NAV  |[HELD] | SPACE | BOOTL |
                        bindings = <
   &kp LBKT &kp LBRC &kp LPAR &kp MINUS   &kp EQUAL &kp STAR &kp FSLH  &kp RPAR &kp RBRC &kp RBKT
   &kp N1    &kp N2   &kp N3   &kp N4     &kp N5   &kp N6 &kp N7    &kp N8  &kp N9    &kp N0
   &kp GRAVE    &kp AT   &kp HASH   &kp DOLLAR     &kp PERCENT   &kp CARET &kp AMPS    &kp LT  &kp GT    &kp BSLH
                      &kp TAB  &kp LSHIFT  &mo 2    &mo 1  &kp SPACE &bootloader
                        >;
                };

                raise_layer {
                        display-name = "NAV";
//-----------------------------------------------------------------------------------
// | BDEV0 | BDEV1 | BDEV2 | BDEV3 | BDEV4 | MACEL | MDECL | PLAY  | VDOWN |  VUP  |
// | MLEFT | MDOWN | MUP   | MRGHT | MCLCK | ALEFT | ADOWN | AUP   | ARGHT |       |
// | SLEFT | SDOWN | SUP   | SRGHT | SHIFT |       |       |       | BDOWN |  BUP  |
//                 | BOOTL | SHIFT |[HELD] |       | SPACE |  DEL  |
                        bindings = <
   &msc SCRL_LEFT &msc SCRL_DOWN &msc SCRL_UP &msc SCRL_RIGHT &kp LSHIFT &trans &trans &kp C_PLAY_PAUSE &kp C_VOLUME_DOWN &kp C_VOLUME_UP
   &mmv MOVE_LEFT &mmv MOVE_DOWN &mmv MOVE_UP &mmv MOVE_RIGHT &mkp MB1 &kp LEFT_ARROW &kp DOWN_ARROW &kp UP_ARROW &kp RIGHT_ARROW &trans
    &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &bt BT_CLR &trans &trans &kp C_BRIGHTNESS_DEC &kp C_BRIGHTNESS_INC
                                 &bootloader &kp LSHIFT &mo 2    &mo 1  &kp SPACE &kp BSPC
                        >;
                };
        };
};

